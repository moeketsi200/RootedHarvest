# ==========================================
# ROOTED South Africa - Email & Weather Config
# ==========================================

# To send real verification emails directly to user inboxes (e.g. Gmail / Outlook / SendGrid):
# 1. For Gmail: Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
# 2. Set SMTP_USER=your-email@gmail.com
# 3. Generate a 16-character Google "App Password" (at https://myaccount.google.com/apppasswords) and set SMTP_PASS
# 4. If left blank, real email delivery preview links are automatically logged to the terminal console.

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="ROOTED South Africa" <noreply@rooted.co.za>
